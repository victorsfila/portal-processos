{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/andamento.js": {
      "maxDuration": 60
    },
    "api/atualizar.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/atualizar",
      "schedule": "0 9 * * *"
    }
  ]
}
